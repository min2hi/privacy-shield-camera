# ============================================================
# INFRASTRUCTURE ENVIRONMENT VARIABLES
# Copy file này thành .env và điền giá trị thực
# KHÔNG commit file .env lên git
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=privacy_shield_agent
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# --- Langfuse (AgentOps Dashboard) ---
LANGFUSE_PORT=3000
LANGFUSE_SECRET_KEY=change_me_langfuse_secret_32chars
LANGFUSE_SALT=change_me_langfuse_salt_32chars
LANGFUSE_NEXTAUTH_SECRET=change_me_nextauth_secret
LANGFUSE_NEXTAUTH_URL=http://localhost:3000

# --- LiteLLM Gateway ---
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-litellm-change_me

# API Keys (chỉ điền cái bạn dùng, để trống nếu không dùng)
OPENAI_API_KEY=sk-proj-your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# --- Ollama (LLM local, miễn phí) ---
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2:3b

# --- Agent App ---
DATABASE_URL=postgresql://agent_user:change_me_strong_password@localhost:5432/privacy_shield_agent
REDIS_URL=redis://:change_me_redis_password@localhost:6379
LITELLM_URL=http://localhost:4000
LANGFUSE_PUBLIC_KEY=pk-lf-change_me
LANGFUSE_SECRET_KEY_APP=sk-lf-change_me
LANGFUSE_HOST=http://localhost:3000

# --- Workspace (Agent chỉ được thao tác trong đây) ---
AGENT_WORKSPACE_PATH=d:/StudioProjects/AI project
